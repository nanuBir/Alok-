rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false; // Add the first admin document through Firebase Console only.
    }
    match /bookings/{bookingId} {
      allow create: if request.resource.data.keys().hasOnly([
          'name','phone','company','location','equipment','model','date','issue','status','createdAt'
        ])
        && request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 100
        && request.resource.data.phone is string && request.resource.data.phone.size() >= 8 && request.resource.data.phone.size() <= 20
        && request.resource.data.location is string && request.resource.data.location.size() >= 2 && request.resource.data.location.size() <= 120
        && request.resource.data.equipment is string && request.resource.data.equipment.size() <= 100
        && request.resource.data.issue is string && request.resource.data.issue.size() >= 5 && request.resource.data.issue.size() <= 2000
        && request.resource.data.status == 'New';
      allow read, update, delete: if isAdmin();
    }
    match /projects/{projectId} {
      allow read: if resource.data.published == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }
    match /customers/{customerId} {
      allow read, write: if isAdmin();
    }
    match /siteContent/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
